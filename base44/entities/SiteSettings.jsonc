    },
    "tagline_ku": {
      "type": "string",
      "default": "\u0644\u0648\u06a9\u0633\u06a9\u0627\u0631\u06cc \u0648\u0631\u062f \u0644\u06d5\u0633\u06d5\u0631 \u0686\u06d5\u0631\u062e",
