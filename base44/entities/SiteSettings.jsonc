    "tagline_ar": {
      "type": "string",
      "default": "\u0627\u0644\u0641\u062e\u0627\u0645\u0629 \u0627\u0644\u062f\u0642\u064a\u0642\u0629 \u0639\u0644\u0649 \u0639\u062c\u0644\u0627\u062a",
