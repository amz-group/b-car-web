{
  "name": "Review",
  "type": "object",
  "properties": {
    "car_id": {
      "type": "string",
      "title": "Car ID"
    },
    "car_name": {
      "type": "string",
      "title": "Car Name"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 5,
      "title": "Rating (1-5)"
    },
    "comment": {
      "type": "string",
      "title": "Comment"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Review Images (up to 5)",
      "maxItems": 5
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "title": "Approved"
    }
  },
  "required": [
    "car_id",
    "customer_name",
    "rating",
    "comment"
  ]
}