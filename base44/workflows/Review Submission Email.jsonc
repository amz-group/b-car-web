{
  "description": "\u0626\u0627\u06af\u0627\u062f\u0627\u0631\u06a9\u0631\u062f\u0646\u06d5\u0648\u06d5\u06cc \u0626\u06c6\u062a\u06c6\u0645\u0627\u062a\u06cc\u06a9\u06cc \u0626\u06cc\u0645\u06d5\u06cc\u06b5 \u06a9\u0627\u062a\u06ce\u06a9 \u06a9\u0695\u06cc\u0627\u0631 \u067e\u06ce\u062f\u0627\u0686\u0648\u0648\u0646\u06d5\u0648\u06d5\u06cc \u0646\u0648\u06ce \u067e\u06ce\u0634\u06a9\u06d5\u0634 \u062f\u06d5\u06a9\u0627\u062a",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "review_submission_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_email": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendRequestNotification",
            "args": {
              "type": "review",
              "car_name": "${ .trigger.data.car_name }",
              "customer_name": "${ .trigger.data.customer_name }",
              "rating": "${ .trigger.data.rating }",
              "comment": "${ .trigger.data.comment }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0646\u0627\u0631\u062f\u0646\u06cc \u0626\u06cc\u0645\u06d5\u06cc\u06b5\u06cc \u067e\u06ce\u062f\u0627\u0686\u0648\u0648\u0646\u06d5\u0648\u06d5",
            "description": "\u0626\u0627\u06af\u0627\u062f\u0627\u0631\u06a9\u0631\u062f\u0646\u06d5\u0648\u06d5\u06cc \u062e\u0627\u0648\u06d5\u0646\u06d5\u06a9\u06d5 \u0628\u06d5 \u067e\u06ce\u062f\u0627\u0686\u0648\u0648\u0646\u06d5\u0648\u06d5\u06cc \u0646\u0648\u06ce"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Review"
    }
  },
  "name": "Review Submission Email"
}